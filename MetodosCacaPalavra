package JogosPOO;

import java.util.Random;
import java.util.Scanner;

public class MetodosCacaPalavra {

	private int tamanho = 10;
	private char[][] tabuleiro = new char[tamanho][tamanho];
	private Random random = new Random();
	EscolherPalavra escolher = new EscolherPalavra();
	Dica dica = new Dica();
	Scanner scanner = new Scanner(System.in);

	public MetodosCacaPalavra() {
	}

	public void iniciarJogo() {
		String palavraHorizontal = escolher.sorteio();
		String palavraVertical = escolher.sorteio();

		while (palavraVertical.equalsIgnoreCase(palavraHorizontal)) {
			palavraVertical = escolher.sorteio();
		}

		preencherTabuleiro();
		inserirPalavraHorizontal(palavraHorizontal);
		inserirPalavraVertical(palavraVertical);

		System.out.println("\nTabuleiro com palavras escondidas:");
		imprimirTabuleiro();

		int tentativas = 1;
		boolean acertouHorizontal = false;
		boolean acertouVertical = false;

		while (!acertouHorizontal || !acertouVertical) {
			System.out.println("\nDigite uma das palavras escondidas no tabuleiro:");
			System.out.println("(Ou digite 'dica' para receber dicas, ou '0' para desistir)");
			String tentativa = scanner.nextLine();

			if (tentativa.equalsIgnoreCase("0")) {
				System.out.println("Você desistiu! As palavras eram: " + palavraHorizontal + " e " + palavraVertical);
				break;
			} else if (tentativa.equalsIgnoreCase("dica")) {
				System.out.println("Dicas:");
				dica.exibir(palavraHorizontal);
				dica.exibir(palavraVertical);
			} else if (!acertouHorizontal && tentativa.equalsIgnoreCase(palavraHorizontal)) {
				System.out.println("Parabéns! Você acertou a primeira palavra  com " + tentativas + " tentativa(s).");
				acertouHorizontal = true;
			} else if (!acertouVertical && tentativa.equalsIgnoreCase(palavraVertical)) {
				System.out.println("Parabéns! Você acertou a segunda palavra com " + tentativas + " tentativa(s).");
				acertouVertical = true;
			} else {
				System.out.println("Palavra incorreta. Tente novamente.");
				tentativas++;
			}
		}

		if (acertouHorizontal && acertouVertical) {
			System.out.println("Parabéns! Você encontrou todas as palavras!");
		}
	}

	private void preencherTabuleiro() {
		for (int i = 0; i < tamanho; i++) {
			for (int j = 0; j < tamanho; j++) {
				tabuleiro[i][j] = (char) ('a' + random.nextInt(26));
			}
		}
	}

	private void imprimirTabuleiro() {
		for (int i = 0; i < tamanho; i++) {
			for (int j = 0; j < tamanho; j++) {
				System.out.print(tabuleiro[i][j] + " ");
			}
			System.out.println();
		}
	}

	private void inserirPalavraHorizontal(String palavra) {
		int linha = random.nextInt(tamanho);
		int coluna = random.nextInt(tamanho - palavra.length());

		for (int i = 0; i < palavra.length(); i++) {
			tabuleiro[linha][coluna + i] = palavra.charAt(i);
		}
	}

	private void inserirPalavraVertical(String palavra) {
		int linha = random.nextInt(tamanho - palavra.length());
		int coluna = random.nextInt(tamanho);

		for (int i = 0; i < palavra.length(); i++) {
			tabuleiro[linha + i][coluna] = palavra.charAt(i);
		}
	}

	public int getTamanho() {
		return tamanho;
	}

	public void setTamanho(int tamanho) {
		this.tamanho = tamanho;
		this.tabuleiro = new char[tamanho][tamanho];
	}

	public char[][] getTabuleiro() {
		return tabuleiro;
	}
}

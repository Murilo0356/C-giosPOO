package JogosPOO;

import java.util.Random;
import java.util.Scanner;

public class MetodosDescoberta {
	Random random = new Random();
	Scanner scanner = new Scanner(System.in);
	Dica dica = new Dica();

	public MetodosDescoberta() {

	}

	public String embaralhar(String palavra) {
		char[] palavraArray = palavra.toCharArray();
		for (int x = 0; x < palavraArray.length; x++) {
			int indiceAleatorio = random.nextInt(palavraArray.length);
			char temp = palavraArray[x];
			palavraArray[x] = palavraArray[indiceAleatorio];
			palavraArray[indiceAleatorio] = temp;
		}
		return new String(palavraArray);
	}

	public void jogar(String palavraSelecionada) {
		int tentativas = 1;
		boolean acertou = false;

		while (!acertou) {
			System.out.println("Informe a palavra, 'dica' para receber uma dica ou '0' para desistir:");
			String entrada = scanner.nextLine();

			if (entrada.equals("0")) {
				desistir(tentativas);
				break;
			}

			if (entrada.equalsIgnoreCase("dica")) {
				dica.exibir(palavraSelecionada);
				continue;
			}

			if (entrada.equalsIgnoreCase(palavraSelecionada)) {
				System.err.println("Você acertou com " + tentativas + " tentativas!");
				acertou = true;
			} else {
				tentativas++;
			}
		}
	}

	public void desistir(int tentativas) {
		System.out.println("Frangote desistiu com " + tentativas + " tentativas");
	}
}
